FROM ubuntu:24.04

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates libstdc++6 libssl3t64 zlib1g libfuse3-3 libpcsclite1 fuse3 util-linux mount \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 65532 liquid \
 && useradd --system --uid 65532 --gid 65532 --no-create-home --no-log-init --home-dir /var/lib/liquid-identity --shell /usr/sbin/nologin --key SYS_UID_MAX=65532 liquid \
 && install -d -o 65532 -g 65532 -m 0700 /var/lib/liquid-worker /var/lib/liquid-identity

ARG LIQUID_BINARY=build-linux/liquid
ARG LIQUID_READ_GUARD=build-linux/liquid-read-guard
COPY --chmod=0555 ${LIQUID_BINARY} /usr/local/bin/liquid
COPY --chmod=0555 ${LIQUID_READ_GUARD} /usr/local/libexec/liquid/liquid-read-guard

ENV LIQUID_READ_GUARD=/usr/local/libexec/liquid/liquid-read-guard
# The worker signs its requests and results with the identity in LIQUID_HOME and executes only
# leases signed by the scheduler identity document mounted at /etc/liquid/scheduler (liquid #416).
ENV LIQUID_HOME=/var/lib/liquid-identity

VOLUME ["/var/lib/liquid-worker", "/var/lib/liquid-identity"]
USER 65532:65532
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/liquid", "worker"]
CMD ["--scheduler", "127.0.0.1:50051", "--trust-scheduler", "/etc/liquid/scheduler", "--control-listen", "127.0.0.1:8081", "--root", "/var/lib/liquid-worker"]
