if(NOT DEFINED LIQUID_GRAMMAR_LOCK OR NOT DEFINED LIQUID_GRAMMAR_SOURCE_MAP)
  message(FATAL_ERROR "grammar digest verification requires the lock and source map")
endif()

file(READ "${LIQUID_GRAMMAR_LOCK}" lock_json)
file(STRINGS "${LIQUID_GRAMMAR_SOURCE_MAP}" source_rows)
string(JSON grammar_count LENGTH "${lock_json}" grammars)
math(EXPR grammar_last "${grammar_count} - 1")

foreach(source_row IN LISTS source_rows)
  if(NOT source_row MATCHES "^([^|]+)\\|(.*)$")
    message(FATAL_ERROR "invalid grammar source row: ${source_row}")
  endif()
  set(language "${CMAKE_MATCH_1}")
  set(source_dir "${CMAKE_MATCH_2}")
  set(lock_index "")
  foreach(index RANGE ${grammar_last})
    string(JSON candidate GET "${lock_json}" grammars ${index} language)
    if(candidate STREQUAL language)
      set(lock_index ${index})
      break()
    endif()
  endforeach()
  if(lock_index STREQUAL "")
    message(FATAL_ERROR "${language}: source map language is absent from lock")
  endif()

  string(JSON parser_path GET "${lock_json}" grammars ${lock_index} parser path)
  string(JSON parser_sha256 GET "${lock_json}" grammars ${lock_index} parser sha256)
  file(SHA256 "${source_dir}/${parser_path}" actual_parser_sha256)
  if(NOT actual_parser_sha256 STREQUAL parser_sha256)
    message(FATAL_ERROR "${language}: parser.c digest mismatch")
  endif()

  string(JSON scanner_count LENGTH "${lock_json}" grammars ${lock_index} scanners)
  if(scanner_count GREATER 0)
    math(EXPR scanner_last "${scanner_count} - 1")
    foreach(scanner_index RANGE ${scanner_last})
      string(JSON scanner_path GET "${lock_json}" grammars ${lock_index} scanners ${scanner_index} path)
      string(JSON scanner_sha256 GET "${lock_json}" grammars ${lock_index} scanners ${scanner_index} sha256)
      file(SHA256 "${source_dir}/${scanner_path}" actual_scanner_sha256)
      if(NOT actual_scanner_sha256 STREQUAL scanner_sha256)
        message(FATAL_ERROR "${language}: ${scanner_path} digest mismatch")
      endif()
    endforeach()
  endif()

  string(JSON tags_type TYPE "${lock_json}" grammars ${lock_index} tags)
  if(NOT tags_type STREQUAL "NULL")
    string(JSON tags_path GET "${lock_json}" grammars ${lock_index} tags path)
    string(JSON tags_sha256 GET "${lock_json}" grammars ${lock_index} tags sha256)
    file(SHA256 "${source_dir}/${tags_path}" actual_tags_sha256)
    if(NOT actual_tags_sha256 STREQUAL tags_sha256)
      message(FATAL_ERROR "${language}: tags.scm digest mismatch")
    endif()
  endif()
endforeach()

list(LENGTH source_rows verified_count)
message(STATUS "verified ${verified_count} grammar parser, scanner, and tags digest sets")
