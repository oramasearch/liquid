@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(OpenSSL)
find_dependency(ZLIB)
find_dependency(zstd CONFIG)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT TARGET PkgConfig::LIQUID_FUSE3)
  find_dependency(PkgConfig)
  pkg_check_modules(LIQUID_FUSE3 REQUIRED IMPORTED_TARGET fuse3)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/liquidTargets.cmake")
if(NOT TARGET Boost::capy)
  add_library(Boost::capy ALIAS liquid::capy)
endif()
check_required_components(liquid)
