#!/bin/sh
set -eu
if [ "$(readlink '/usr/bin/liquid-agent-current' 2>/dev/null || true)" != '/usr/lib/liquid/agent' ]; then
    ln -sfn '/usr/lib/liquid/agent' '/usr/bin/liquid-agent-current'
fi
if command -v 'update-alternatives' >/dev/null 2>&1; then
    update-alternatives --install '/usr/bin/liquid-tool' 'liquid-tool' '/usr/lib/liquid/tool' 40
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
if [ -d /run/systemd/system ]; then
    systemctl enable --now 'liquid_agent.service'
fi
if command -v 'ldconfig' >/dev/null 2>&1; then
    ldconfig
fi
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
exit 0
