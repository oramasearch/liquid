if(NOT DEFINED LIQUID_CLI)
  message(FATAL_ERROR "LIQUID_CLI is required")
endif()
if(NOT DEFINED LIQUID_CLI_ROOT)
  message(FATAL_ERROR "LIQUID_CLI_ROOT is required")
endif()

function(run_liquid output error result directory)
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env "LIQUID_HOME=${LIQUID_CLI_ROOT}/identity" "${LIQUID_CLI}" ${ARGN}
    WORKING_DIRECTORY "${directory}"
    RESULT_VARIABLE command_result
    OUTPUT_VARIABLE command_output
    ERROR_VARIABLE command_error)
  set("${output}" "${command_output}" PARENT_SCOPE)
  set("${error}" "${command_error}" PARENT_SCOPE)
  set("${result}" "${command_result}" PARENT_SCOPE)
endfunction()

function(require_success result output error)
  if(NOT ${result} EQUAL 0)
    message(FATAL_ERROR "liquid failed with ${${result}}:\n${${output}}${${error}}")
  endif()
  message(STATUS "${${output}}")
endfunction()

file(REMOVE_RECURSE "${LIQUID_CLI_ROOT}")
file(MAKE_DIRECTORY "${LIQUID_CLI_ROOT}/workspace/notes")
file(MAKE_DIRECTORY "${LIQUID_CLI_ROOT}/other")
file(WRITE "${LIQUID_CLI_ROOT}/workspace/first.txt" "first\n")
file(WRITE "${LIQUID_CLI_ROOT}/workspace/notes/second.txt" "second\n")
file(WRITE "${LIQUID_CLI_ROOT}/other/child.txt" "child\n")

set(workspace "${LIQUID_CLI_ROOT}/workspace")
set(other "${LIQUID_CLI_ROOT}/other")
set(split "${LIQUID_CLI_ROOT}/split")

run_liquid(init_output init_error init_result "${workspace}" init .)
require_success(init_result init_output init_error)

run_liquid(search_plan_output search_plan_error search_plan_result "${workspace}"
  search --explain "\"first\"")
require_success(search_plan_result search_plan_output search_plan_error)
string(JSON search_executor GET "${search_plan_output}" executor)
string(JSON search_kind GET "${search_plan_output}" query_kind)
string(JSON search_alternatives LENGTH "${search_plan_output}" alternatives)
string(JSON search_drips GET "${search_plan_output}" inputs drips_since_index_update)
if(NOT search_executor STREQUAL "scan" OR NOT search_kind STREQUAL "literal" OR
   NOT search_alternatives EQUAL 3 OR NOT search_drips EQUAL 0)
  message(FATAL_ERROR "search explain JSON changed: ${search_plan_output}")
endif()

run_liquid(status_output status_error status_result "${workspace}" status --json)
require_success(status_result status_output status_error)
string(REGEX MATCH "\"pending_drips\":0" imported_files "${status_output}")
if(NOT imported_files)
  message(FATAL_ERROR "open did not checkpoint imported files: ${status_output}")
endif()
string(REGEX MATCH "\"remote_bytes\":0" no_remote_bytes "${status_output}")
if(NOT no_remote_bytes)
  message(FATAL_ERROR "status did not report remote bytes: ${status_output}")
endif()

run_liquid(cut_output cut_error cut_result "${workspace}" cut imported)
require_success(cut_result cut_output cut_error)
run_liquid(move_output move_error move_result "${workspace}" move first.txt moved.txt)
require_success(move_result move_output move_error)
run_liquid(moved_cut_output moved_cut_error moved_cut_result "${workspace}" cut moved)
require_success(moved_cut_result moved_cut_output moved_cut_error)
string(REGEX MATCH "change=([^\n]+)" imported_change "${cut_output}")
set(imported_change "${CMAKE_MATCH_1}")
string(REGEX MATCH "change=([^\n]+)" moved_change "${moved_cut_output}")
set(moved_change "${CMAKE_MATCH_1}")
run_liquid(anchor_output anchor_error anchor_result "${workspace}"
  anchor "first.txt:1@${imported_change}" --to "${moved_change}")
require_success(anchor_result anchor_output anchor_error)
string(REGEX MATCH "^moved.txt:1:1@[^ ]+ moved=true approximate=false deleted=false"
  moved_anchor "${anchor_output}")
if(NOT moved_anchor)
  message(FATAL_ERROR "anchor did not follow the moved node: ${anchor_output}")
endif()
run_liquid(history_output history_error history_result "${workspace}" history moved.txt)
require_success(history_result history_output history_error)
string(FIND "${history_output}" "${imported_change}" history_imported)
string(FIND "${history_output}" "${moved_change}" history_moved)
if(history_imported EQUAL -1 OR history_moved EQUAL -1)
  message(FATAL_ERROR "path history did not follow the moved node: ${history_output}")
endif()
run_liquid(restore_output restore_error restore_result "${workspace}"
  history moved.txt --restore "${imported_change}")
require_success(restore_result restore_output restore_error)
string(FIND "${restore_output}" "restored moved.txt from ${imported_change}" restored_version)
if(restored_version EQUAL -1)
  message(FATAL_ERROR "history restore omitted its source change: ${restore_output}")
endif()
run_liquid(restored_cut_output restored_cut_error restored_cut_result "${workspace}" cut restored)
require_success(restored_cut_result restored_cut_output restored_cut_error)

run_liquid(other_init_output other_init_error other_init_result "${other}" init .)
require_success(other_init_result other_init_output other_init_error)
run_liquid(other_cut_output other_cut_error other_cut_result "${other}" cut child)
require_success(other_cut_result other_cut_output other_cut_error)

run_liquid(nest_output nest_error nest_result "${workspace}" nest "${other}" nested)
require_success(nest_result nest_output nest_error)
run_liquid(split_output split_error split_result "${workspace}" split notes "${split}")
require_success(split_result split_output split_error)
run_liquid(combine_output combine_error combine_result "${workspace}" combine "${split}" --at combined)
require_success(combine_result combine_output combine_error)
run_liquid(combined_cut_output combined_cut_error combined_cut_result "${workspace}" cut combined)
require_success(combined_cut_result combined_cut_output combined_cut_error)
run_liquid(final_move_output final_move_error final_move_result "${workspace}" move nested nested-moved)
require_success(final_move_result final_move_output final_move_error)

run_liquid(log_output log_error log_result "${workspace}" log --json)
require_success(log_result log_output log_error)
string(REGEX MATCH "\"message\":\"combined\"" combined_log "${log_output}")
if(NOT combined_log)
  message(FATAL_ERROR "log JSON omitted the combined change: ${log_output}")
endif()

run_liquid(log_ops_output log_ops_error log_ops_result "${workspace}" log --ops --json)
require_success(log_ops_result log_ops_output log_ops_error)
string(REGEX MATCH "\"kind\":\"move\"" moved_operation "${log_ops_output}")
if(NOT moved_operation)
  message(FATAL_ERROR "log --ops JSON omitted the move: ${log_ops_output}")
endif()
string(JSON move_session GET "${log_ops_output}" 0 session)
run_liquid(ops_output ops_error ops_result "${workspace}" ops --json)
require_success(ops_result ops_output ops_error)

run_liquid(undo_output undo_error undo_result "${workspace}" undo --session "${move_session}"
  --path nested-moved)
require_success(undo_result undo_output undo_error)
string(REGEX MATCH "applied [^\n]+" session_applied "${undo_output}")
if(NOT session_applied)
  message(FATAL_ERROR "session undo omitted its applied report: ${undo_output}")
endif()
run_liquid(lock_output lock_error lock_result "${workspace}" lock nested)
require_success(lock_result lock_output lock_error)
run_liquid(locked_output locked_error locked_result "${workspace}" rm nested)
if(locked_result EQUAL 0)
  message(FATAL_ERROR "locked mutation unexpectedly succeeded")
endif()
string(REGEX MATCH "error: locked:" locked_error_code "${locked_error}")
if(NOT locked_error_code)
  message(FATAL_ERROR "locked mutation omitted the error code: ${locked_error}")
endif()

run_liquid(pause_output pause_error pause_result "${workspace}" pause)
require_success(pause_result pause_output pause_error)
string(REGEX MATCH "capture_state=paused" paused_capture "${pause_output}")
if(NOT paused_capture)
  message(FATAL_ERROR "pause did not report paused capture: ${pause_output}")
endif()
run_liquid(resume_output resume_error resume_result "${workspace}" resume)
require_success(resume_result resume_output resume_error)
string(REGEX MATCH "capture_state=running" resumed_capture "${resume_output}")
if(NOT resumed_capture)
  message(FATAL_ERROR "resume did not report running capture: ${resume_output}")
endif()

run_liquid(gc_output gc_error gc_result "${workspace}" gc .)
require_success(gc_result gc_output gc_error)
run_liquid(moved_output moved_error moved_result "${workspace}" materialise checkout-moved moved.txt)
require_success(moved_result moved_output moved_error)
file(READ "${workspace}/checkout-moved/moved.txt" moved_contents)
if(NOT moved_contents STREQUAL "first\n")
  message(FATAL_ERROR "collected repository lost moved.txt: ${moved_contents}")
endif()
run_liquid(combined_output combined_error combined_result "${workspace}" materialise checkout-combined combined)
require_success(combined_result combined_output combined_error)
file(READ "${workspace}/checkout-combined/second.txt" combined_contents)
if(NOT combined_contents STREQUAL "second\n")
  message(FATAL_ERROR "collected repository lost combined/second.txt: ${combined_contents}")
endif()
run_liquid(collected_log_output collected_log_error collected_log_result "${workspace}" log --json)
require_success(collected_log_result collected_log_output collected_log_error)
string(REGEX MATCH "\"message\":\"combined\"" collected_change "${collected_log_output}")
if(NOT collected_change)
  message(FATAL_ERROR "collection lost history: ${collected_log_output}")
endif()
run_liquid(collected_refs_output collected_refs_error collected_refs_result "${workspace}" refs --json)
require_success(collected_refs_result collected_refs_output collected_refs_error)
string(REGEX MATCH "\"name\":\"main\"" collected_main "${collected_refs_output}")
if(NOT collected_main)
  message(FATAL_ERROR "collection lost main reference: ${collected_refs_output}")
endif()
message(STATUS "scenario output:\n${init_output}${status_output}${cut_output}${move_output}${moved_cut_output}${anchor_output}${history_output}${restore_output}${restored_cut_output}${nest_output}${split_output}${combine_output}${combined_cut_output}${final_move_output}${log_output}${log_ops_output}${ops_output}${undo_output}${lock_output}${locked_error}${pause_output}${resume_output}${gc_output}${moved_output}${combined_output}${collected_log_output}${collected_refs_output}")
